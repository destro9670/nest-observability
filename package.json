{
	"name": "@varent/nest-observability",
	"version": "1.0.0",
	"description": "Nest Observability Kit",
	"license": "ISC",
	"author": "dm.gabz",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/invero-projects/nest-observability-kit.git"
	},
	"homepage": "https://github.com/invero-projects/nest-observability-kit#readme",
	"bugs": {
		"url": "https://github.com/invero-projects/nest-observability-kit/issues"
	},
	"keywords": [
		"nestjs",
		"observability",
		"opentelemetry",
		"winston",
		"logging"
	],
	"engines": {
		"node": ">=20"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./logger": {
			"types": "./dist/modules/logger/index.d.ts",
			"require": "./dist/modules/logger/index.js",
			"default": "./dist/modules/logger/index.js"
		},
		"./opentelemetry": {
			"types": "./dist/modules/opentelemetry/index.d.ts",
			"require": "./dist/modules/opentelemetry/index.js",
			"default": "./dist/modules/opentelemetry/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "npm run clean && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.build.json --noEmit",
		"format": "prettier --write \"lib/**/*.ts\" \"test/**/*.ts\" README.md package.json",
		"format:check": "prettier --check \"lib/**/*.ts\" \"test/**/*.ts\" README.md package.json",
		"test": "jest --runInBand",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@nestjs/common": "^10.0.0 || ^11.0.0",
		"@nestjs/core": "^10.0.0 || ^11.0.0",
		"@nestjs/testing": "^10.0.0 || ^11.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.0.10",
		"@trivago/prettier-plugin-sort-imports": "^5.2.2",
		"jest": "^30.2.0",
		"prettier": "^3.8.1",
		"reflect-metadata": "^0.2.2",
		"rimraf": "^6.0.1",
		"rxjs": "^7.8.2",
		"ts-jest": "^29.4.6",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@opentelemetry/auto-instrumentations-node": "0.78.0",
		"@opentelemetry/exporter-logs-otlp-http": "0.220.0",
		"@opentelemetry/exporter-metrics-otlp-http": "0.220.0",
		"@opentelemetry/exporter-trace-otlp-http": "0.220.0",
		"@opentelemetry/instrumentation-host-metrics": "0.3.0",
		"@opentelemetry/instrumentation-winston": "0.64.0",
		"@opentelemetry/otlp-exporter-base": "0.220.0",
		"@opentelemetry/resources": "2.9.0",
		"@opentelemetry/sdk-logs": "0.220.0",
		"@opentelemetry/sdk-metrics": "2.9.0",
		"@opentelemetry/sdk-node": "0.220.0",
		"@opentelemetry/sdk-trace": "2.9.0",
		"@opentelemetry/semantic-conventions": "1.43.0",
		"@opentelemetry/winston-transport": "0.30.0",
		"nest-winston": "^1.10.2",
		"winston": "^3.19.0"
	},
	"peerDependencies": {
		"@nestjs/common": "^10.0.0 || ^11.0.0",
		"@nestjs/core": "^10.0.0 || ^11.0.0",
		"reflect-metadata": "^0.2.0",
		"rxjs": "^7.8.0"
	}
}
